---
import Base from './Base.astro';
import { SITE_NAME, withBase, absolute } from '../config/site';
import { HURUF, type Paket } from '../lib/paket';

interface Props { paket: Paket }
const { paket } = Astro.props;
const pageUrl = absolute(`/paket/${paket.slug}/`);

const faqData = [
  {
    q: `Ada berapa soal dalam paket ${paket.judul} ini?`,
    a: `Ada ${paket.soal.length} soal pilihan ganda. Setiap soal langsung diperiksa saat diklik dan dilengkapi pembahasan. Perkiraan waktu pengerjaan sekitar ${paket.durasiMenit} menit. Komposisi materinya: ${paket.komposisi.map((k) => `${k.topik} ${k.jumlah} soal`).join(', ')}.`,
  },
  {
    q: `Apakah soal di paket ini sama dengan soal seleksi TNI yang sebenarnya?`,
    a: `Tidak — dan tidak ada situs mana pun yang bisa menjanjikan itu. Soal seleksi TNI bersifat rahasia dan tidak pernah diterbitkan oleh panitia. Soal di sini adalah soal latihan ORISINAL yang kami susun mengikuti mata uji yang umum diujikan pada seleksi TNI dan materi pelajarannya (kurikulum SMA, Pancasila, UUD 1945, serta dasar-dasar UU No. 34 Tahun 2004 tentang TNI), dengan pola dan tingkat kesulitan yang menyerupai ujian sebenarnya. Itulah arti kata "prediksi" yang jujur di situs ini.`,
  },
  {
    q: `Bisakah paket ini dicetak untuk latihan di kertas?`,
    a: `Bisa. Gulir ke bagian "Teks Soal & Kunci Jawaban" di halaman ini, lalu gunakan tombol Cetak Paket. Kunci jawaban dan pembahasan tercetak terpisah di bagian akhir agar tidak mengintip jawaban sebelum selesai.`,
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqData.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
const crumbsLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Beranda', item: absolute('/') },
    { '@type': 'ListItem', position: 2, name: 'Paket Soal', item: absolute('/paket/') },
    { '@type': 'ListItem', position: 3, name: paket.judul, item: pageUrl },
  ],
};
const learnLd = {
  '@context': 'https://schema.org',
  '@type': 'LearningResource',
  name: paket.judul,
  description: paket.intro,
  url: pageUrl,
  learningResourceType: 'Practice questions',
  inLanguage: 'id',
  isAccessibleForFree: true,
};
---

<Base title={paket.judul} description={paket.intro} path={`/paket/${paket.slug}/`}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(crumbsLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(learnLd)} />
  </Fragment>

  <nav class="breadcrumb">
    <a href={withBase('/')}>beranda</a> / <a href={withBase('/paket/')}>paket soal</a> / <span>{paket.slug}</span>
  </nav>

  <div class="paket-head">
    <h1>{paket.judul}</h1>
    <div class="paket-meta">
      <span class="chip besar">{paket.jalur}</span>
      <span class="chip besar">{paket.soal.length} soal pilihan ganda</span>
      <span class="chip besar">±{paket.durasiMenit} menit</span>
      <span class="chip besar">Klik jawaban — langsung ketahuan benar atau salah</span>
    </div>
  </div>

  <div id="kuis-app" class="kuis-app"></div>
  <script type="application/json" id="paket-data" set:html={JSON.stringify(paket)}></script>

  <p class="lead narrow" style="margin-top:26px">{paket.intro}</p>
  <p class="petunjuk narrow">
    Paket ini adalah <strong>latihan orisinal berlabel prediksi</strong>: disusun mengikuti mata uji yang
    umum diujikan pada seleksi {paket.jalur} dan materi pelajarannya — <strong>bukan bocoran dan bukan
    soal resmi TNI</strong>. Lihat juga <a href={withBase('/kisi-kisi/')}>halaman kisi-kisi</a> untuk peta
    materi dan catatan kejujuran sumbernya. Mau mengerjakan di kertas? Cetak paketnya dari bagian teks
    di bawah — kunci jawaban tercetak terpisah di bagian akhir.
  </p>

  <section class="print-area" id="teks-terbuka">
    <div class="teks-kepala">
      <h2>Teks Soal &amp; Kunci Jawaban</h2>
      <button class="btn ghost no-print" onclick="window.print()">Cetak Paket</button>
    </div>
    <p class="no-print" style="color:var(--muted)">
      Seluruh soal paket ini dalam bentuk teks — berguna untuk memeriksa soal terlebih dahulu,
      menyalinnya, atau mencetaknya. Kunci jawaban dan pembahasan ada di bagian paling bawah,
      terpisah dari soalnya.
    </p>
    <ol class="teks-soal">
      {paket.soal.map((s) => (
        <li>
          <p class="tanya">{s.tanya} <span class="topik-tag">({s.topik})</span></p>
          <ol class="teks-opsi" type="A">
            {s.pilihan.map((p) => <li>{p}</li>)}
          </ol>
        </li>
      ))}
    </ol>

    <div class="kunci-area">
      <h2>Kunci Jawaban</h2>
      <p class="kunci-grid">
        {paket.soal.map((s, i) => (
          <span>{i + 1}. <strong>{HURUF[s.kunci]}</strong></span>
        ))}
      </p>
      <h3>Pembahasan</h3>
      <ol class="teks-soal">
        {paket.soal.map((s) => (
          <li><p><strong>Jawaban: {HURUF[s.kunci]}.</strong> {s.bahasan}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <div class="prose narrow">
    <h2>Pertanyaan umum</h2>
    {faqData.map((f) => (
      <details class="faq">
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
    <p>
      Kembali ke <a href={withBase('/paket/')}>daftar semua paket</a> atau pelajari dulu
      <a href={withBase('/kisi-kisi/')}> kisi-kisi dan tahapan seleksinya</a>.
    </p>
  </div>

  <script>
    import { initKuis } from '../lib/quiz.js';
    initKuis();
  </script>
</Base>
